<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee                              http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>org.apache.catalina.filters.SetCharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <param-name>ignore</param-name>
            <param-value>false</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <!-- ============ GUEST / HOME ============ -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>controller.home.HomeServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AboutServlet</servlet-name>
        <servlet-class>controller.home.AboutServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AddUserServlet</servlet-name>
        <servlet-class>controller.admin.AddUserServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>EditUserServlet</servlet-name>
        <servlet-class>controller.admin.EditUserServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AdminAddCourseServlet</servlet-name>
        <servlet-class>controller.admin.AdminAddCourseServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AdminEditCourseServlet</servlet-name>
        <servlet-class>AdminEditCourseServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PaymentSuccessServlet</servlet-name>
        <servlet-class>controller.student.PaymentSuccessServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>WalletServlet</servlet-name>
        <servlet-class>controller.student.WalletServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>CourseDetailServlet</servlet-name>
        <servlet-class>controller.home.CourseDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CourseDetailServlet</servlet-name>
        <url-pattern>/course</url-pattern>
    </servlet-mapping>
    <!-- Thêm MyCoursesServlet cho sinh viên và giảng viên -->
    <servlet>
        <servlet-name>MyCoursesServlet</servlet-name>
        <servlet-class>controller.home.MyCoursesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MyCoursesServlet</servlet-name>
        <url-pattern>/myCourses</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>CourseListServlet</servlet-name>
        <servlet-class>controller.home.CourseListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CourseListServlet</servlet-name>
        <url-pattern>/courseList</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>controller.home.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>
    <!-- ============ AUTH ============ -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.auth.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>controller.auth.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controller.auth.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <!-- ============ STUDENT ============ -->
    <servlet>
        <servlet-name>EnrollCourseServlet</servlet-name>
        <servlet-class>controller.student.EnrollCourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EnrollCourseServlet</servlet-name>
        <url-pattern>/student/enroll</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>UnenrollCourseServlet</servlet-name>
        <servlet-class>controller.student.UnenrollCourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UnenrollCourseServlet</servlet-name>
        <url-pattern>/student/unenroll</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>PaymentServlet</servlet-name>
        <servlet-class>controller.student.PaymentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentServlet</servlet-name>
        <url-pattern>/payment</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>PaymentSuccessServlet</servlet-name>
        <servlet-class>controller.student.PaymentSuccessServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentSuccessServlet</servlet-name>
        <url-pattern>/payment-success</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>WalletServlet</servlet-name>
        <servlet-class>controller.student.WalletServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WalletServlet</servlet-name>
        <url-pattern>/wallet</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>LearnServlet</servlet-name>
        <servlet-class>controller.student.LearnServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LearnServlet</servlet-name>
        <url-pattern>/student/learn</url-pattern>
    </servlet-mapping>
    <!-- ============ INSTRUCTOR ============ -->
    <servlet>
        <servlet-name>InstructorViewRegistrationsServlet</servlet-name>
        <servlet-class>controller.instructor.InstructorViewRegistrationsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InstructorViewRegistrationsServlet</servlet-name>
        <url-pattern>/instructor/registrations</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>UpdateRegistrationStatusServlet</servlet-name>
        <servlet-class>controller.instructor.UpdateRegistrationStatusServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateRegistrationStatusServlet</servlet-name>
        <url-pattern>/instructor/update-status</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>InstructorEditCourseServlet</servlet-name>
        <servlet-class>controller.instructor.InstructorEditCourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InstructorEditCourseServlet</servlet-name>
        <url-pattern>/instructor/edit-course</url-pattern>
    </servlet-mapping>
    <!-- ============ ADMIN ============ -->
    <servlet>
        <servlet-name>ManageUsersServlet</servlet-name>
        <servlet-class>controller.admin.ManageUsersServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ManageUsersServlet</servlet-name>
        <url-pattern>/admin/manageUsers</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>AddUserServlet</servlet-name>
        <servlet-class>controller.admin.AddUserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddUserServlet</servlet-name>
        <url-pattern>/admin/addUser</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>EditUserServlet</servlet-name>
        <servlet-class>controller.admin.EditUserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EditUserServlet</servlet-name>
        <url-pattern>/admin/editUser</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>AdminAddCourseServlet</servlet-name>
        <servlet-class>controller.admin.AdminAddCourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminAddCourseServlet</servlet-name>
        <url-pattern>/admin/addCourse</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>AdminEditCourseServlet</servlet-name>
        <servlet-class>controller.admin.AdminEditCourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminEditCourseServlet</servlet-name>
        <url-pattern>/admin/editCourse</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ManageCoursesServlet</servlet-name>
        <servlet-class>controller.admin.ManageCoursesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ManageCoursesServlet</servlet-name>
        <url-pattern>/admin/manageCourses</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>StatisticsServlet</servlet-name>
        <servlet-class>controller.admin.StatisticsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StatisticsServlet</servlet-name>
        <url-pattern>/admin/statistics</url-pattern>
    </servlet-mapping>
    <!-- ============ SESSION ============ -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    <!-- ============ WELCOME ============ -->
    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>
</web-app>
